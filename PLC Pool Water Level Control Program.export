      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">IF ResetActuator THEN
	ValveCommand := MAX(0.0, MIN(100.0, InitialValvePosition));
	TargetValveCommand := ValveCommand;
	I := 0.0;
	
	PreviousKp := K_p;
	PreviousKi := K_i;
	HasPreviousGains := TRUE;
	RETURN;
END_IF;

IF Paused THEN
	RETURN;
END_IF;

IF AutomationEnabled AND NOT TripActive THEN
	e := - MeasuredLevel;
	P := K_p * e;
	
	// match the new controller output to the current valve position
	IF HasPreviousGains AND ((K_p &lt;&gt; PreviousKp) OR (K_i &lt;&gt; PreviousKi)) THEN
		I := ValveCommand - P;
	END_IF;
	
	I := I + K_i * e * TimeStep;
	u := P + I;
	
	// prevent integral windup
	IF ((u &gt; 100.0) AND (e &gt; 0.0)) OR ((u &lt; 0.0) AND (e &lt; 0.0)) THEN
		I := I - K_i * e * TimeStep; // restore previous value
	END_IF;
	
	TargetValveCommand := MAX(0.0, MIN(100.0, P + I));
	
ELSE
	TargetValveCommand := 0.0;
	I := 0.0; // reset I
END_IF;

// Move actual valve position towards controller output
MaxMove := (100.0 / ValveTravelTime) * TimeStep;

ValveCommand := ValveCommand + MAX(-MaxMove, MIN(MaxMove, TargetValveCommand - ValveCommand));

ValveCommand := MAX(0.0, MIN(100.0, ValveCommand));

PreviousKp := K_p;
PreviousKi := K_i;
HasPreviousGains := TRUE;</Single>
            <Single Name="LineInfoPersistence" Type="string">b05a2395-a599-469c-b7e2-6a1a86c226cd_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK ValveController
VAR_INPUT
	Paused : BOOL;
	AutomationEnabled : BOOL := FALSE;
	TripActive : BOOL := FALSE;
	MeasuredLevel : REAL := 0.0; // inches. Positive means it's above the nomial level
	TimeStep : REAL := 0.1; //seconds 
	K_p : REAL := 1.0; // proportional tuning constant
	K_i : REAL := 1.0; // integral tuning contsant
	
	// to model a gradual response rather than instantaneous
	ResetActuator : BOOL := FALSE;
	InitialValvePosition : REAL := 0.0;
END_VAR
VAR_OUTPUT
	ValveCommand : REAL := 0.0; // percent to open
END_VAR
VAR
	// controller variables
	e : REAL := 0.0; // error
	P : REAL := 0.0; // proportional component
	I : REAL := 0.0; // integral component	
	u : REAL := 0.0; // valve command placeholder
	
	// for gradual response
	TargetValveCommand : REAL;
	MaxMove : REAL;
	ValveTravelTime : REAL := 20.0; // seconds to go from fully closed to fully open or vice versa 
	PreviousKp : REAL;
	PreviousKi : REAL;
	HasPreviousGains : BOOL := FALSE;
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">b05a2395-a599-469c-b7e2-6a1a86c226cd_Decl_LineIds</Single>
          </Single>
