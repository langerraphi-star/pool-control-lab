    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">6df5fc54-7813-4136-85d0-88a6ef79c429</Single>
        <Single Name="ParentGuid" Type="System.Guid">a2ef2902-d4ea-4fd4-b126-4517b1398757</Single>
        <Single Name="Name" Type="string">PoolModel</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639300135548354006</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">IF Reset THEN
	Volume := InitialVolume;
	BackwashActive := FALSE;
	BackwashElapsed := 0.0;
	BackwashFlow := 0.0;
	FillFlow := 0.0;
	EvapFlow := 0.0; // gpm
	SplashFlow := 0.0; // gpm
	RainFlow := 0.0; // gpm
	LeakFlow := 0.0;
ELSE
	IF PoolType = 'Indoor' THEN
		EvapFlow := (SurfaceArea / 12) * 7.48052 * (EvapPerDay / 1440);
	ELSIF PoolType = 'Outdoor' THEN
		EvapFlow := (SurfaceArea / 12) * 7.48052 * (EvapPerDay * 2 / 1440);
	ELSE
		EvapFlow := 0;
	END_IF;
	
	SplashFlow := BatherCount * SplashPerBather / 60;
	
	IF RainEnabled THEN
		RainFlow := (SurfaceArea * 7.48052 / (12 * 60)) * RainPerHour;
	ELSE
		RainFlow := 0;
	END_IF;
	
	
	IF LeakEnabled THEN
		LeakFlow := LeakRate; 
	ELSE
		LeakFlow := 0;
	END_IF;
	
	// use time remaining for backwash if it is less than TimeStep
	BackwashTimeStep := MAX(0.0, MIN(TimeStep, BackwashDuration - BackwashElapsed));
	
	IF StartBackwash AND NOT StopBackwash THEN
		BackwashActive := TRUE;
	END_IF;
	
	IF StopBackwash THEN
		BackwashActive := FALSE;
		BackwashElapsed := 0.0;
	END_IF;
	
	IF BackwashElapsed &gt;= BackwashDuration THEN
		BackwashActive := FALSE;
		BackwashElapsed := 0.0;
	END_IF;
	
	IF BackWashActive THEN
		BackwashFlow := BackwashRate;
		BackwashElapsed := BackwashElapsed + BackwashTimeStep;
	ELSE
		BackwashFlow := 0;
	END_IF;

	
	IF ValveCommand &gt; 100 THEN
		CorrectedValveCommand := 100;
	ELSIF ValveCommand &lt; 0 THEN
		CorrectedValveCommand := 0;
	ELSE
		CorrectedValveCommand := ValveCommand;
	END_IF;
	FillFlow := MaxFillFlow * (CorrectedValveCommand / 100);
	
	// update volume
	Volume := Volume + (FillFlow + RainFlow - EvapFlow - SplashFlow - LeakFlow) * TimeStep / 60 - BackwashFlow * BackwashTimeStep / 60;
	
END_IF;
	
ActualLevel := 12.0 * ((Volume - NominalVolume) / 7.48052) / SurfaceArea;

// Simulate a failed sensor condition where it is stuck at a below-nominal reading
IF Reset THEN
	MeasuredLevel := InitialMeasuredLevel;
ELSIF SensorFailed THEN
	MeasuredLevel := -1.0; 
ELSIF SensorLag &lt;= 0 THEN
	MeasuredLevel := ActualLevel;
ELSE
	MeasuredLevel := MeasuredLevel + (1 - EXP(-TimeStep / SensorLag)) * (ActualLevel - MeasuredLevel);
END_IF;

HighHigh := ActualLevel &gt;= 1; // calculated independently of MeasuredLevel to be safe from sensor malfunctions</Single>
            <Single Name="LineInfoPersistence" Type="string">6df5fc54-7813-4136-85d0-88a6ef79c429_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK PoolModel
VAR_INPUT
	
	// pool metrics
	PoolType           : STRING; // 'Indoor' or 'Outdoor' 
	InitialVolume      : REAL := 100000;   // wherever pool was at when auto tuning started
	
	// data
	Reset              : BOOL; // return to initial conditions
	InitialMeasuredLevel : REAL; // inches (from stilling well)
	ValveCommand       : REAL; // %
	TimeStep           : REAL; // s
	SensorLag          : REAL; // s
	
	// physical constants
	MaxFillFlow       : REAL := 50.0; // gpm, typical for 2" fill line
	EvapPerDay        : REAL; // inches - scale x2 for outdoor
	SplashPerBather   : REAL; // splash loss (gal per hr)
	RainPerHour       : REAL; // inches
	LeakRate          : REAL; // gpm
	BackwashDuration  : REAL := 300.0; // five minutes
	BackWashRate      : REAL := 150.0; // gpm
	
	// inputs
	BatherCount   : INT := 0; // current occupancy
	StartBackwash : BOOL := FALSE;
	StopBackwash  : BOOL := FALSE;
	
	// Status variables
	RainEnabled  : BOOL := FALSE;
	LeakEnabled  : BOOL := FALSE; 
	SensorFailed : BOOL := FALSE;
	
END_VAR
VAR_OUTPUT
	Volume        : REAL; // current volume in gal
	ActualLevel   : REAL; // inches
	MeasuredLevel : REAL; // inches (from sensor)
	FillFlow      : REAL; // gpm
	HighHigh      : BOOL; 
END_VAR
VAR
	CorrectedValveCommand : REAL := 0.0; // % 0 &lt;= x &lt;= 100
	SensorLevel         : REAL;	
	NominalVolume       : REAL := 100000.0; // gal
	SurfaceArea         : REAL := 2500.0; // sq ft
	EvapFlow            : REAL := 0.0; // gpm
	SplashFlow          : REAL := 0.0; // gpm
	RainFlow            : REAL := 0.0; // gpm
	LeakFlow            : REAL := 0.0; // gpm
	BackwashFlow        : REAL := 0.0; // gpm
	BackwashActive      : BOOL := FALSE;
	BackwashElapsed     : REAL := 0.0; // seconds
	BackwashTimeStep    : REAL := 0.0; // s
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">6df5fc54-7813-4136-85d0-88a6ef79c429_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">231</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">a2ef2902-d4ea-4fd4-b126-4517b1398757</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
