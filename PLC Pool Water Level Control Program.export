      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">b6ac4edb-b40f-4268-a7b0-cf3436f2f304</Single>
        <Single Name="ParentGuid" Type="System.Guid">a2ef2902-d4ea-4fd4-b126-4517b1398757</Single>
        <Single Name="Name" Type="string">TuningManager</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639303279439048687</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">
Tuner(
	Start := StartTuning,
	InitialKp := PLC_PRG.ActiveKp,
	InitialKi := PLC_PRG.ActiveKi,
	InitialValvePosition := PLC_PRG.LevelController.ValveCommand,
	InitialVolume := TankSimulation.Volume,
	InitialMeasuredLevel := PLC_PRG.PoolLevelDeviation,
	PoolType := TankSimulation.PoolType,
	BatherCount := TankSimulation.BatherCount,
	MaxFillFlow := TankSimulation.MaxFillFlow,
	EvapPerDay := TankSimulation.EvapPerDay,
	SplashPerBather := TankSimulation.SplashPerBather,
	RainPerHour := TankSimulation.RainPerHour,
	LeakRate := TankSimulation.LeakRate,
	RainEnabled := TankSimulation.RainEnabled,
	LeakEnabled := TankSimulation.LeakEnabled,
	SensorLag := 5.0 // seconds
	);
	
IF Tuner.Done AND Tuner.HasValidBest AND NOT Tuner.Failed THEN
	PLC_PRG.ActiveKp := Tuner.BestKp;
	PLC_PRG.ActiveKi := Tuner.BestKi;
END_IF;

StartTuning := FALSE;	</Single>
            <Single Name="LineInfoPersistence" Type="string">b6ac4edb-b40f-4268-a7b0-cf3436f2f304_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM TuningManager
VAR
	Tuner : Twiddle;
	StartTuning : BOOL := FALSE; // pulse true to start tuning
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">b6ac4edb-b40f-4268-a7b0-cf3436f2f304_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">34</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">a2ef2902-d4ea-4fd4-b126-4517b1398757</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC Logic</Single>
        <Single Type="string">Application</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">d7328787-b65a-48c9-845a-257aeeebd25c</Single>
        <Single Name="ParentGuid" Type="System.Guid">a2ef2902-d4ea-4fd4-b126-4517b1398757</Single>
        <Single Name="Name" Type="string">TuningTrial</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639303287083833785</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">IF Start THEN
	// reset Failed parameter
	Failed := FALSE;
	Score := 0.0;
	Elapsed := 0.0;
	
	// validate time parameters
	IF TimeStep &lt;= 0.0 OR TrialDuration &lt;= 0.0 THEN
		Busy := FALSE;
		Done := TRUE;
		Failed := TRUE;
	ELSE
		Score := 0.0;
		Elapsed := 0.0;
		TrialPool(
			Reset := TRUE,
			InitialVolume := InitialVolume,
			InitialMeasuredLevel := InitialMeasuredLevel,
			PoolType := PoolType,
			TimeStep := TimeStep,
			SensorLag := SensorLag,
			MaxFillFlow := MaxFillFlow,
			EvapPerDay := EvapPerDay,
			SplashPerBather := SplashPerBather,
			BatherCount := BatherCount,
			RainPerHour := RainPerHour,
			RainEnabled := RainEnabled,
			LeakRate := LeakRate,
			LeakEnabled := LeakEnabled,
			ValveCommand := 0.0,
			StartBackwash := FALSE,
			StopBackwash := FALSE,
			SensorFailed := FALSE
			);
		
		TrialController(
				Paused := FALSE,
				AutomationEnabled := FALSE,
				TripActive := FALSE,
				MeasuredLevel := TrialPool.MeasuredLevel,
				TimeStep := TimeStep,
				K_p := CandidateKp,
				K_i := CandidateKi,
				ResetActuator := TRUE,
				InitialValvePosition := InitialValvePosition
				);
				
		Busy := TRUE;
		DONE := FALSE;
	END_IF;
	
		
ELSIF Busy THEN
	IF TrialPool.HighHigh THEN
		Busy := FALSE;
		Done := TRUE;
		Failed := TRUE;
	ELSE
		StepDuration := MAX(0.0, MIN(TimeStep, TrialDuration - Elapsed));
		
		TrialController(
			Paused := FALSE,
			AutomationEnabled := TRUE,
			TripActive := FALSE,
			MeasuredLevel := TrialPool.MeasuredLevel,
			TimeStep := StepDuration,
			K_p := CandidateKp,
			K_i := CandidateKi,
			ResetActuator := FALSE
		);
		
		TrialPool(
			Reset := FALSE,
			InitialVolume := InitialVolume,
			InitialMeasuredLevel := InitialMeasuredLevel,
			PoolType := PoolType,
			TimeStep := StepDuration,
			SensorLag := SensorLag,
			MaxFillFlow := MaxFillFlow,
			EvapPerDay := EvapPerDay,
			SplashPerBather := SplashPerBather,
			BatherCount := BatherCount,
			RainPerHour := RainPerHour,
			RainEnabled := RainEnabled,
			LeakRate := LeakRate,
			LeakEnabled := LeakEnabled,
			ValveCommand := TrialController.ValveCommand,
			StartBackwash := FALSE,
			StopBackwash := FALSE,
			SensorFailed := FALSE
		);
		
		// check high limit again in case duration has been reached
		IF TrialPool.HighHigh THEN
			Busy := FALSE;
			Done := TRUE;
			Failed := TRUE;
		END_IF;
		
		Score := Score + ABS(TrialPool.ActualLevel) * StepDuration;
		Elapsed := Elapsed + StepDuration;
	
	END_IF;
	
	IF Elapsed &gt;= TrialDuration THEN
		Busy := FALSE;
		Done := TRUE;
	END_IF;
	
END_IF;</Single>
            <Single Name="LineInfoPersistence" Type="string">d7328787-b65a-48c9-845a-257aeeebd25c_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK TuningTrial
VAR_INPUT
	Start : BOOL; // to initialize trial
	CandidateKp : REAL;
	CandidateKi : REAL;
	InitialVolume : REAL;
	InitialMeasuredLevel : REAL;
	InitialValvePosition : REAL;
	TimeStep : REAL;
	TrialDuration : REAL; // length of simulation to run
	
	// to be imported from PoolModel
	PoolType          : STRING; // 'Indoor' or 'Outdoor' 
	BatherCount   : INT := 0; // current occupancy
	MaxFillFlow       : REAL := 50.0; // gpm, typical for 2" fill line
	EvapPerDay        : REAL; // inches - scale x2 for outdoor
	SplashPerBather   : REAL; // splash loss (gal per hr)
	RainPerHour       : REAL; // inches
	LeakRate          : REAL; // gpm
	RainEnabled       : BOOL := FALSE;
	LeakEnabled       : BOOL := FALSE; 
	SensorLag          : REAL; // s
END_VAR
VAR_OUTPUT
	Busy : BOOL; // whether trial is running
	Done : BOOL;
	Score : LREAL; // cumulative trial score
	Failed : BOOL := FALSE; // invalid or high-tripped trial
END_VAR
VAR
	TrialPool : PoolModel; // simulation model used for testing gain parameters
	TrialController : ValveController; 
	StepDuration : REAL;
	Elapsed : REAL; // s
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">d7328787-b65a-48c9-845a-257aeeebd25c_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">225</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">a2ef2902-d4ea-4fd4-b126-4517b1398757</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC Logic</Single>
        <Single Type="string">Application</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">5d507ece-553e-4432-a890-1ce908396e8b</Single>
        <Single Name="ParentGuid" Type="System.Guid">a2ef2902-d4ea-4fd4-b126-4517b1398757</Single>
        <Single Name="Name" Type="string">Twiddle</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639303281314203502</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">IF Start AND NOT Busy THEN
	Busy := TRUE;
	Done := FALSE;
	Failed := FALSE;
	Converged := FALSE;
	TestingNegative := FALSE;
	HasValidBest := FALSE;
	BestScore := 0.0;
	Iteration := 0;
	DeltaKp := 10.0;
	DeltaKi := 0.25;
	
	// initialize the stored gains
	BestKp := InitialKp;
	BestKi := InitialKi;
	TestKp := InitialKp;
	TestKi := InitialKi;
	
	// capture snapshot 
	SnapshotVolume          := InitialVolume;
	SnapshotMeasuredLevel   := InitialMeasuredLevel;
	SnapshotValvePosition   := InitialValvePosition;
	SnapshotPoolType        := PoolType;
	SnapshotBatherCount     := BatherCount;
	SnapshotMaxFillFlow     := MaxFillFlow;
	SnapshotEvapPerDay      := EvapPerDay;
	SnapshotSplashPerBather := SplashPerBather;
	SnapshotRainPerHour     := RainPerHour;
	SnapshotLeakRate        := LeakRate;
	SnapshotRainEnabled     := RainEnabled;
	SnapshotLeakEnabled     := LeakEnabled; 
	SnapshotSensorLag       := SensorLag;
	
	// advance to next stage
	State := 10;
END_IF;

CASE State OF
	0:
		// nothing
	
	10: 
		Trial(
			Start := TRUE,
			CandidateKp := TestKp,
			CandidateKi := TestKi,
			InitialVolume := SnapshotVolume,
			InitialMeasuredLevel := SnapshotMeasuredLevel,
			InitialValvePosition := SnapshotValvePosition,
			TimeStep := TimeStep,
			TrialDuration := TrialDuration,
			PoolType := SnapshotPoolType,
			BatherCount := SnapshotBatherCount,
			MaxFillFlow := SnapshotMaxFillFlow,
			EvapPerDay := SnapshotEvapPerDay,
			SplashPerBather := SnapshotSplashPerBather,
			RainPerHour := SnapshotRainPerHour,
			LeakRate := SnapshotLeakRate,
			RainEnabled := SnapshotRainEnabled,
			LeakEnabled := SnapshotLeakEnabled,			
			SensorLag := SnapshotSensorLag
			);
		
		State := 20;
	
	20:
		FOR StepIndex := 1 TO StepsPerScan DO
			Trial(
				Start := FALSE,
				CandidateKp := TestKp,
				CandidateKi := TestKi,
				InitialVolume := SnapshotVolume,
				InitialMeasuredLevel := SnapshotMeasuredLevel,
				InitialValvePosition := SnapshotValvePosition,
				TimeStep := TimeStep,
				TrialDuration := TrialDuration,
				PoolType := SnapshotPoolType,
				BatherCount := SnapshotBatherCount,
				MaxFillFlow := SnapshotMaxFillFlow,
				EvapPerDay := SnapshotEvapPerDay,
				SplashPerBather := SnapshotSplashPerBather,
				RainPerHour := SnapshotRainPerHour,
				LeakRate := SnapshotLeakRate,
				RainEnabled := SnapshotRainEnabled,
				LeakEnabled := SnapshotLeakEnabled,			
				SensorLag := SnapshotSensorLag
				);
				IF Trial.Done THEN
					EXIT;
				END_IF;
			END_FOR;
			
		IF Trial.Done THEN
			State := 30;
		END_IF;
	
	30:
		IF NOT Trial.Failed THEN
			BestScore := Trial.Score;
			HasValidBest := TRUE;
			
			// get ready to run Kp trial
			ParameterIndex := 0;
			TestKp := BestKp + DeltaKp;
			TestKi := BestKi;
			
			State := 40;
		ELSE
			Failed := TRUE;
			Busy := FALSE;
			Done := TRUE;
			State := 0; // end the search
		END_IF;
		
	40:
		Trial(
			Start := TRUE,
			CandidateKp := TestKp,
			CandidateKi := TestKi,
			InitialVolume := SnapshotVolume,
			InitialMeasuredLevel := SnapshotMeasuredLevel,
			InitialValvePosition := SnapshotValvePosition,
			TimeStep := TimeStep,
			TrialDuration := TrialDuration,
			PoolType := SnapshotPoolType,
			BatherCount := SnapshotBatherCount,
			MaxFillFlow := SnapshotMaxFillFlow,
			EvapPerDay := SnapshotEvapPerDay,
			SplashPerBather := SnapshotSplashPerBather,
			RainPerHour := SnapshotRainPerHour,
			LeakRate := SnapshotLeakRate,
			RainEnabled := SnapshotRainEnabled,
			LeakEnabled := SnapshotLeakEnabled,			
			SensorLag := SnapshotSensorLag
			);
			
		State := 50;
	
	50:
		FOR StepIndex := 1 TO StepsPerScan DO
			Trial(
				Start := FALSE,
				CandidateKp := TestKp,
				CandidateKi := TestKi,
				InitialVolume := SnapshotVolume,
				InitialMeasuredLevel := SnapshotMeasuredLevel,
				InitialValvePosition := SnapshotValvePosition,
				TimeStep := TimeStep,
				TrialDuration := TrialDuration,
				PoolType := SnapshotPoolType,
				BatherCount := SnapshotBatherCount,
				MaxFillFlow := SnapshotMaxFillFlow,
				EvapPerDay := SnapshotEvapPerDay,
				SplashPerBather := SnapshotSplashPerBather,
				RainPerHour := SnapshotRainPerHour,
				LeakRate := SnapshotLeakRate,
				RainEnabled := SnapshotRainEnabled,
				LeakEnabled := SnapshotLeakEnabled,			
				SensorLag := SnapshotSensorLag
				);
				IF Trial.Done THEN
					EXIT;
				END_IF;
			END_FOR;
		
		IF Trial.Done THEN
			State := 60;
		END_IF;
			
	60:
		
		IF NOT Trial.Failed AND Trial.Score &lt; BestScore THEN
			BestScore := Trial.Score;
			BestKp := TestKp;
			BestKi := TestKi;
			IF ParameterIndex = 0 THEN
				DeltaKp := DeltaKp * 1.1;
			ELSIF ParameterIndex = 1 THEN
				DeltaKi := DeltaKi * 1.1;
			END_IF;
			State := 70; // to switch to the next parameter
		ELSE
			IF TestingNegative THEN
				// if positive and negative increments didn't improve the score then shrink the increment and move to the next gain
				IF ParameterIndex = 0 THEN
					DeltaKp := DeltaKp * 0.9; // shrink
				ELSIF ParameterIndex = 1 THEN
					DeltaKi := DeltaKi * 0.9; // shrink
				END_IF;
				State := 70; 
			ELSE
				// if positive increment didn't work then try a negative increment on the same gain parameter
				TestKp := BestKp;
				TestKi := BestKi;
				IF ParameterIndex = 0 THEN
					TestKp := MAX(0.0, BestKp - DeltaKp);
				ELSIF ParameterIndex = 1 THEN
					TestKi := MAX(0.0, BestKi - DeltaKi);
				END_IF;
				TestingNegative := TRUE;
				State := 40;
			END_IF;
		END_IF;
	
	70:
		IF ParameterIndex = 0 THEN
			ParameterIndex := 1;
		ELSIF ParameterIndex = 1 THEN
			ParameterIndex := 0;
			Iteration := Iteration + 1;
		END_IF;
		
		IF ((DeltaKp &lt;= ToleranceKp) AND (DeltaKi &lt;= ToleranceKi)) OR (Iteration &gt;= MaxIterations) THEN
			Busy := FALSE;
			Done := TRUE;
			State := 0;
			Converged := (DeltaKp &lt;= ToleranceKp) AND (DeltaKi &lt;= ToleranceKi);
		ELSE
			TestingNegative := FALSE;
			TestKp := BestKp;
			TestKi := BestKi;
			IF ParameterIndex = 0 THEN
				TestKp := BestKp + DeltaKp;
			ELSIF ParameterIndex = 1 THEN
				TestKi := BestKi + DeltaKi;
			END_IF;
			State := 40;
		END_IF;
			
		
	
	
END_CASE;</Single>
            <Single Name="LineInfoPersistence" Type="string">5d507ece-553e-4432-a890-1ce908396e8b_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK Twiddle
VAR_INPUT
	Start : BOOL; // one-call pulse to begin tuning
	InitialKp : REAL;
	InitialKi : REAL;
	InitialValvePosition : REAL;
	
	// pool data
	InitialVolume : REAL;
	InitialMeasuredLevel : REAL;
	
	// environmental settings
	PoolType          : STRING; // 'Indoor' or 'Outdoor' 
	BatherCount   : INT := 0; // current occupancy
	MaxFillFlow       : REAL := 50.0; // gpm, typical for 2" fill line
	EvapPerDay        : REAL; // inches - scale x2 for outdoor
	SplashPerBather   : REAL; // splash loss (gal per hr)
	RainPerHour       : REAL; // inches
	LeakRate          : REAL; // gpm
	RainEnabled       : BOOL := FALSE;
	LeakEnabled       : BOOL := FALSE; 
	SensorLag          : REAL; // s
END_VAR

VAR_OUTPUT
	Busy : BOOL;
	Done : BOOL;
	Failed : BOOL;
	Converged : BOOL; // if optimization thresholds were reached
	
	BestKp : REAL; 
	BestKi : REAL;
	BestScore : LREAL;
	HasValidBest : BOOL; // whether any trial was successful
END_VAR

VAR
	// data parameters
	TimeStep : REAL := 0.1; // s
	TrialDuration : REAL := 100.0; // s
	Trial : TuningTrial; // evaluate candidate gains
	State : INT := 0; // current stage of the search
	StepIndex : INT;
	StepsPerScan : INT := 1000; // to speed up the computation
	
	// gain-related variables
	ParameterIndex : INT; // Which gain is being adjusted
	TestKp : REAL := 40.0; // Starting point
	TestKi : REAL := 1.0; // Starting point
	DeltaKp : REAL := 10.0; // search increments
	DeltaKi : REAL := 0.25;                                                                                                         
	Iteration : INT := 0; 
	TestingNegative : BOOL := FALSE; // whether a negative DeltaGain is being tested
	
	// snapshot variables to ignore conditions changing mid-tuning
	SnapshotVolume            : REAL;
	SnapshotMeasuredLevel     : REAL;
	SnapshotValvePosition     : REAL;
	SnapshotPoolType          : STRING; // 'Indoor' or 'Outdoor' 
	SnapshotBatherCount       : INT := 0; // current occupancy
	SnapshotMaxFillFlow       : REAL := 50.0; // gpm, typical for 2" fill line
	SnapshotEvapPerDay        : REAL; // inches - scale x2 for outdoor
	SnapshotSplashPerBather   : REAL; // splash loss (gal per hr)
	SnapshotRainPerHour       : REAL; // inches
	SnapshotLeakRate          : REAL; // gpm
	SnapshotRainEnabled       : BOOL := FALSE;
	SnapshotLeakEnabled       : BOOL := FALSE; 
	SnapshotSensorLag         : REAL; // s
	
	// optimization thresholds
	ToleranceKp : REAL := 0.1;
	ToleranceKi : REAL := 0.005;
	MaxIterations : INT := 100;
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">5d507ece-553e-4432-a890-1ce908396e8b_Decl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="UniqueIdGenerator" Type="string">453</Single>
        <Single Name="POULevel" Type="{8e575c5b-1d37-49c6-941b-5c0ec7874787}">Standard</Single>
        <List Name="ChildObjectGuids" Type="System.Collections.ArrayList" />
        <Single Name="AddAttributeSubsequent" Type="bool">False</Single>
      </Single>
      <Single Name="ParentSVNodeGuid" Type="System.Guid">a2ef2902-d4ea-4fd4-b126-4517b1398757</Single>
      <Array Name="Path" Type="string">
        <Single Type="string">Device</Single>
        <Single Type="string">PLC Logic</Single>
        <Single Type="string">Application</Single>
      </Array>
      <Single Name="Index" Type="int">-1</Single>
    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">b05a2395-a599-469c-b7e2-6a1a86c226cd</Single>
        <Single Name="ParentGuid" Type="System.Guid">a2ef2902-d4ea-4fd4-b126-4517b1398757</Single>
        <Single Name="Name" Type="string">ValveController</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
