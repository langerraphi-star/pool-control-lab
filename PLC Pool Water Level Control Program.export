        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM PLC_PRG
VAR
	AutomationEnabled: BOOL; // FALSE means system is in manual mode
	ValveCommand : REAL := 0.0; // this is the precent-open that the valve needs to be
	FillingRequest : BOOL := FALSE;
	LowLevel : BOOL := FALSE; // when tank reaches 30% or less
	HighLevel : BOOL := FALSE; // when tank reaches 80% or more
	Trip : BOOL := FALSE; // activated automatically when HighHigh becomes TRUE
	ResetTrip : BOOL := FALSE;  // activated by operator switch
	
	// configure the controller
	LevelController : ValveController;
END_VAR

VAR_INPUT
	PoolLevelDeviation : REAL := 0.0; // inches
	HighHigh : BOOL := FALSE; // when level reaches 95% due to a system errors
	ActiveKp : REAL := 40.0;
	ActiveKi : REAL := 1.0;
END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">7aabb10b-6c0f-4c90-bc0b-20593dee36c2_Decl_LineIds</Single>
          </Single>
