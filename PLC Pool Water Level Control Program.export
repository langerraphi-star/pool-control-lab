    </Single>
    <Single Type="{6198ad31-4b98-445c-927f-3258a0e82fe3}" Method="IArchivable">
      <Single Name="IsRoot" Type="bool">False</Single>
      <Single Name="MetaObject" Type="{81297157-7ec9-45ce-845e-84cab2b88ade}" Method="IArchivable">
        <Single Name="Guid" Type="System.Guid">1122b1a4-6cc5-4efa-8212-4e8d0470d959</Single>
        <Single Name="ParentGuid" Type="System.Guid">a2ef2902-d4ea-4fd4-b126-4517b1398757</Single>
        <Single Name="Name" Type="string">TankSimulation</Single>
        <Dictionary Type="{2c41fa04-1834-41c1-816e-303c7aa2c05b}" Name="Properties" />
        <Single Name="TypeGuid" Type="System.Guid">6f9dac99-8de1-4efc-8465-68ac443b7d08</Single>
        <Array Name="EmbeddedTypeGuids" Type="System.Guid">
          <Single Type="System.Guid">a9ed5b7e-75c5-4651-af16-d2c27e98cb94</Single>
          <Single Type="System.Guid">3b83b776-fb25-43b8-99f2-3c507c9143fc</Single>
        </Array>
        <Single Name="Timestamp" Type="long">639303287493637306</Single>
      </Single>
      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">IF NOT Paused THEN
	IF PoolType = 'Indoor' THEN
		EvapFlow := (SurfaceArea / 12) * 7.48052 * (EvapPerDay / 1440);
	ELSIF PoolType = 'Outdoor' THEN
		EvapFlow := (SurfaceArea / 12) * 7.48052 * (EvapPerDay * 2 / 1440);
	ELSE
		EvapFlow := 0;
	END_IF;
	
	SplashFlow := BatherCount * SplashPerBather / 60;
	
	IF RainEnabled THEN
		RainFlow := (SurfaceArea * 7.48052 / (12 * 60)) * RainPerHour;
	ELSE
		RainFlow := 0;
	END_IF;
	
	
	IF LeakEnabled THEN
		LeakFlow := LeakRate; 
	ELSE
		LeakFlow := 0;
	END_IF;
	
	
	IF StartBackwash AND NOT StopBackwash THEN
		BackwashActive := TRUE;
	END_IF;
	
	IF StopBackwash THEN
		BackwashActive := FALSE;
		BackwashElapsed := 0.0;
	END_IF;
	
	IF BackwashElapsed &gt;= BackwashDuration THEN
		BackwashActive := FALSE;
		BackwashElapsed := 0.0;
	END_IF;
	
	IF BackWashActive THEN
		BackwashFlow := BackwashRate;
		BackwashElapsed := BackwashElapsed + TimeStep;
	ELSE
		BackwashFlow := 0;
	END_IF;
	
	
	FillFlow := MaxFillFlow * (PLC_PRG.LevelController.ValveCommand / 100);
	
	// update volume
	Volume := Volume + (FillFlow + RainFlow - EvapFlow - SplashFlow - LeakFlow - BackwashFlow) * TimeStep / 60;
	WaterLevelDeviation := 12.0 * ((Volume - NominalVolume) / 7.48052) / SurfaceArea;
	
	// Simulate a failed sensor condition where it is stuck at a below-nominal reading
	IF SensorFailed THEN
		MeasuredLevel := -1.0; 
	ELSE
		MeasuredLevel := MeasuredLevel + (1.0 - EXP(-TimeStep / SensorLag)) * (WaterLevelDeviation - MeasuredLevel);
	END_IF;
	
	PLC_PRG.PoolLevelDeviation := MeasuredLevel;
	
	PLC_PRG.HighHigh := WaterLevelDeviation &gt;= 1.0; // calculated independently of PoolLevel to be safe from sensor malfunctions
	
END_IF;</Single>
            <Single Name="LineInfoPersistence" Type="string">1122b1a4-6cc5-4efa-8212-4e8d0470d959_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM TankSimulation
VAR
	// pool data
	Volume : REAL := 100000.0; // current pool volume gal
	NominalVolume : REAL := 100000.0; // volume at target WL in gal
	SurfaceArea : REAL := 2500.0; // sq ft
	
	// physical constants
	MaxFillFlow : REAL := 50; // gpm, typical for 2" fill line
	EvapPerDay : REAL := 2; // inches
	SplashPerBather : REAL := 5.0; // splash loss (gal per hr)
	RainPerHour : REAL := 2.0; // inches
	LeakRate : REAL := 15.0; // gpm
	BackwashDuration : REAL := 300.0; // five minutes
	BackWashRate : REAL := 150.0; // gpm
	
	// inputs
	BatherCount : INT := 0; // current occupancy
	StartBackwash : BOOL := FALSE;
	StopBackwash : BOOL := FALSE;
	
	// Status variables
	PoolType : STRING := 'Outdoor'; // other option is 'Indoor'
	RainEnabled : BOOL := FALSE;
	LeakEnabled : BOOL := FALSE; 
	BackwashActive : BOOL := FALSE;
	BackwashElapsed : REAL := 0.0; // seconds
	SensorFailed: BOOL := FALSE;
	
	// Calculated values
	FillFlow: REAL := 0.0; // gpm
	EvapFlow : REAL := 0.0; // gpm
	SplashFlow : REAL := 0.0; // gpm
	RainFlow : REAL := 0.0; // gpm
	LeakFlow: REAL := 0.0; // gpm
	BackWashFlow : REAL := 0.0; // gpm
	WaterLevelDeviation: REAL := 0.0; // inches
	
	// time values
	TimeStep : REAL := 0.1; // s
	Paused : BOOL := FALSE; // user pauses the simulation to re-calibrate
	SensorLag : REAL := 5.0;
	MeasuredLevel : REAL := 0.0;
END_VAR
</Single>
            <Single Name="LineInfoPersistence" Type="string">1122b1a4-6cc5-4efa-8212-4e8d0470d959_Decl_LineIds</Single>
          </Single>
